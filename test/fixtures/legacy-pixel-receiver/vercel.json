{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --ignore-scripts --no-audit --no-fund",
  "buildCommand": "npm test && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/auth/**/*.js": {
      "includeFiles": "server/**",
      "excludeFiles": "{*.test.mjs,test/**,docs/**}"
    },
    "api/game/**/*.js": {
      "includeFiles": "{server/**,progression.js,match-rules.js,match-audit.js,game.js,characters.js,dlsi.js,flow.js,flow-characters.js,penalties.js,bot-brain.js}",
      "excludeFiles": "{*.test.mjs,test/**,docs/**}"
    }
  }
}
